{
  "name": "art-surv",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check-all": "node scripts/check-all.mjs",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src/core src/app",
    "knip": "knip",
    "spell:check": "cspell \"**/*.{ts,js,json,md}\" --no-progress",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:data": "vitest run core/lib/data-loaders/__tests__/data-integrity.test.ts",
    "dry:check": "jscpd . --format typescript,javascript,tsx,jsx --reporters console --ignore \"**/*.test.*,**/*.stories.*,**/dist/**,**/.next/**,**/node_modules/**,**/coverage/**\" --threshold 3",
    "audit:check": "node scripts/audit-check.mjs",
    "size:check": "pnpm build && size-limit",
    "release": "release-it",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
