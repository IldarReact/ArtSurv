{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "description"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique housing identifier"
      },
      "name": {
        "type": "string",
        "description": "Display name"
      },
      "description": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": ["housing"]
      },
      "type": {
        "type": "string"
      },
      "price": {
        "type": "number",
        "minimum": 0,
        "description": "One-time purchase price"
      },
      "costPerQuarter": {
        "type": "number",
        "minimum": 0,
        "description": "Quarterly cost (rent/mortgage)"
      },
      "costPerTurn": {
        "type": "number",
        "minimum": 0
      },
      "isRecurring": {
        "type": "boolean"
      },
      "effects": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "energy": { "type": "number" },
          "happiness": { "type": "number" },
          "sanity": { "type": "number" },
          "health": { "type": "number" },
          "intelligence": { "type": "number" },
          "money": { "type": "number" }
        }
      },
      "minMoney": {
        "type": "number",
        "minimum": 0
      },
      "minSalary": {
        "type": "number",
        "minimum": 0
      },
      "capacity": {
        "type": "integer",
        "minimum": 1,
        "description": "Max family members"
      },
      "maintenanceCost": {
        "type": "number",
        "minimum": 0
      },
      "assetType": {
        "type": "string"
      }
    }
  }
}
